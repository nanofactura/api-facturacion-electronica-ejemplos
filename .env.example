# ─────────────────────────────────────────────────────────────────────────────
#  NanoFactura — API de Facturación Electrónica ARCA
#
#  Copiá este archivo como `.env` y completá tus valores.
#  El `.env` está en .gitignore: NUNCA lo subas al repositorio.
#
#  ¿Cómo obtener estos valores? Necesitás una empresa con plan Premium (o los
#  14 días de prueba gratuita), un certificado de ARCA vinculado y al menos un
#  punto de venta. Se configura una sola vez:
#
#      https://asistentefacturaelectronica.com/ayuda/api
# ─────────────────────────────────────────────────────────────────────────────

# Tu API Key. Se crea en la app, en Administrar Empresa → API Keys, y se
# muestra UNA SOLA VEZ.
#
# El prefijo decide contra qué ARCA se opera, y es lo único que lo decide:
#
#   TEST_  →  homologación · comprobantes SIN validez fiscal · empezá acá
#   PROD_  →  producción   · comprobantes fiscales reales
#
# Pasar a producción es cambiar este valor. El código no cambia.
NANOFACTURA_API_KEY=TEST_00000000000000000000000000000000

# El código de tu empresa. Va en todas las URLs de la API.
# Lo ves en la barra de direcciones de la app: .../app/comprobantes/<id-empresa>
NANOFACTURA_ID_EMPRESA=mi-empresa

# URL base de la API. No hace falta cambiarla.
NANOFACTURA_BASE_URL=https://nanofactura.com/api

# ─────────────────────────────────────────────────────────────────────────────
#  Valores que usan los ejemplos. Ajustalos a tu configuración.
# ─────────────────────────────────────────────────────────────────────────────

# El punto de venta con el que emiten los ejemplos. Tiene que estar dado de
# alta en ARCA (como "Factura Electrónica – Servicio Web") y en NanoFactura.
NANOFACTURA_POS_NUMBER=1
